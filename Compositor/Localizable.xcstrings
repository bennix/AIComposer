    "Edits the selected pixels or selected objects on their own layers. The surrounding photograph is sent as context; nothing new is added to the Layers list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就地修改选中的像素或对象所在图层。周围照片作为环境一并发送；图层列表不会新增图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就地修改選取的像素或物件所在圖層。周圍照片作為環境一併傳送；圖層列表不會新增圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した画素やオブジェクトを元のレイヤー上で編集します。周囲の写真を状況として送り、レイヤーは増やしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 픽셀이나 오브젝트를 원래 레이어에서 수정합니다. 주변 사진을 맥락으로 보내며 레이어는 추가하지 않습니다."
          }
        }
      }
    },
    "Erases the selected pixels or selected objects and rebuilds a matching background from the surroundings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除选中的像素或对象，并用周围环境重建匹配的背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除選取的像素或物件，並用周圍環境重建匹配的背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した画素やオブジェクトを消し、周囲から背景を描き直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 픽셀이나 오브젝트를 지우고 주변에서 배경을 다시 만듭니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
