    "Appearance follows the selected language for every control, menu, tooltip, and AI prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选语言会应用到每一个控件、菜单、提示和 AI 提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選語言會套用到每一個控制項、選單、提示和 AI 提示詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した言語は、すべてのコントロール、メニュー、ツールチップ、AIプロンプトに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어가 모든 컨트롤, 메뉴, 툴팁, AI 프롬프트에 적용됩니다."
          }
        }
      }
    },
