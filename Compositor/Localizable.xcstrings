          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "液化はピクセルを押す · ぼかしは柔らかく · 指先は色を引きずる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액화는 픽셀을 밀고 · 흐림은 부드럽게 · 문지르기는 색을 끕니다"
          }
        }
      }
    },
