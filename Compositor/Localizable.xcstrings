    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用图层蒙版隐藏背景、保留前景。像素仍在，随时可以画回背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用圖層遮罩隱藏背景、保留前景。像素仍在，隨時可以畫回背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクで背景を隠し、前景を残します。ピクセルは残るので、いつでも背景を描けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 마스크로 배경을 숨기고 전경을 남깁니다. 픽셀은 남아 언제든 배경을 다시 칠할 수 있습니다."
          }
        }
      }
    },
    "Hold Shift to add or Option to subtract for one outline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 添加，或按住 Option 从当前轮廓中减去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 加入，或按住 Option 從目前輪廓減去"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftで追加、Optionで今の輪郭から減算"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift는 추가, Option은 현재 윤곽에서 빼기"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道（0–255）与单击颜色的允许偏差"
