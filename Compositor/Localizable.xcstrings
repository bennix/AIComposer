    "Open or create a canvas first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开或创建画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟或建立畫布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にキャンバスを開くか作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 캔버스를 열거나 만드세요."
          }
        }
      }
    },
    "Draw a selection first, then run this command.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先绘制选区，再运行此命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先繪製選取範圍，再執行此命令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に選択範囲を作成してから実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 선택 영역을 그린 뒤 이 명령을 실행하세요."
          }
        }
      }
    },
    "Draw a selection or select one or more objects first, then run this command.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先绘制选区，或选中一个或多个对象，再运行此命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先繪製選取範圍，或選取一個或多個物件，再執行此命令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に選択範囲を作るか、オブジェクトを選んでから実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 선택 영역을 그리거나 하나 이상의 오브젝트를 선택한 뒤 이 명령을 실행하세요."
          }
        }
      }
    },
    "Enter a prompt describing what you want.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入描述目标的提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入描述目標的提示詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作りたい内容をプロンプトで入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 내용을 프롬프트로 입력하세요."
          }
        }
      }
    },
    "The model returned no image. Try another model or a shorter prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型没有返回图像。请换一个模型或缩短提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型沒有返回影像。請換一個模型或縮短提示詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが画像を返しませんでした。別のモデルか短いプロンプトを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 이미지를 반환하지 않았습니다. 다른 모델이나 더 짧은 프롬프트를 시도하세요."
          }
        }
      }
    },
    "The image service returned HTTP %d.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像服务返回 HTTP %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像服務返回 HTTP %d。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像サービスがHTTP %dを返しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 서비스가 HTTP %d를 반환했습니다."
          }
        }
      }
    },
    "Enter at least one side to expand.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少填写一边的扩展像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少填寫一邊的擴展像素。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張する辺を少なくとも1つ入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장할 변을 하나 이상 입력하세요."
          }
        }
      }
    },
    "Add an API key in Settings before generating or editing images.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成或编辑图像前，请先在设置中添加 API 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生或編輯影像前，請先在設定中新增 API 金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の生成や編集の前に、設定でAPIキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 생성하거나 편집하기 전에 설정에서 API 키를 추가하세요."
          }
        }
      }
    },
    "ai.prompt.variation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh variation of this image. Keep the same subject and composition, but change details, styling, and atmosphere enough that it is clearly a new take. Do not add captions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新演绎这张图：保持主体与构图，但充分改变细节、气质和氛围，让它明显是新的一张。不要加字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新演繹這張圖：保持主體與構圖，但充分改變細節、氣質和氛圍，讓它明顯是新的一張。不要加字幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像の新しいバリエーションを作ってください。被写体と構図は保ち、細部・スタイル・雰囲気は明らかに新しいものにしてください。キャプションは入れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 새롭게 변주하세요. 피사체와 구도는 유지하되 세부, 스타일, 분위기는 분명히 다르게 만드세요. 캡션은 넣지 마세요."
          }
        }
      }
    },
    "ai.prompt.restyle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redraw this image in the requested style. Preserve composition, subject identity, and readable text. The style applies to medium, lighting, and finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求的风格重绘此图。保留构图、主体身份和可读文字。风格作用于媒介、光影和质感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求的風格重繪此圖。保留構圖、主體身份和可讀文字。風格作用於媒介、光影和質感。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定のスタイルで描き直してください。構図、被写体の同一性、読みやすい文字は維持し、媒体・照明・仕上げにスタイルを適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 스타일로 다시 그리세요. 구도, 주체 정체성, 읽히는 글자는 유지하고 매체·조명·마감에 스타일을 적용하세요."
          }
        }
      }
    },
    "ai.prompt.sketch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this sketch or rough layout into a finished, photoreal or polished illustration. Respect the lines and proportions. Invent plausible materials and lighting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这张线稿或草图画成完成的照片级或精致插画。尊重线条和比例，合理发明材质与光影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這張線稿或草圖畫成完成的照片級或精緻插畫。尊重線條和比例，合理發明材質與光影。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスケッチを完成した写真または洗練されたイラストにしてください。線と比率を尊重し、妥当な材質と照明を与えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스케치를 완성된 실사 또는 세련된 일러스트로 만드세요. 선과 비율을 존중하고 타당한 재질과 조명을 부여하세요."
          }
        }
      }
    },
    "ai.prompt.colorize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorize this image with natural, historically plausible colors. Keep edges sharp, do not invent new objects, and preserve existing tones that are already colored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这张图上色，颜色自然、符合时代。保持边缘清晰，不要发明新物体，已有颜色予以保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為這張圖上色，顏色自然、符合時代。保持邊緣清晰，不要發明新物體，已有顏色予以保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を自然で時代に即した色でカラー化してください。輪郭はシャープに、新しい物体は加えず、既存の色は残してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지에 자연스럽고 시대에 맞는 색을 입히세요. 가장자리는 선명하게, 새 물체는 만들지 말고 기존 색은 유지하세요."
          }
        }
      }
    },
    "ai.prompt.relight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relight this image as requested. Keep geometry, identity, and text unchanged. Update shadows, highlights, and reflected light so they match the new lighting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求重新打光。几何、身份和文字不变。阴影、高光和反射光必须匹配新光线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求重新打光。幾何、身份和文字不變。陰影、高光和反射光必須匹配新光線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定どおり再照明してください。形状、同一性、文字は変えず、影・ハイライト・反射光を新しい光に合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청대로 다시 조명하세요. 형태, 정체성, 글자는 유지하고 그림자·하이라이트·반사광을 새 빛에 맞추세요."
          }
        }
      }
    },
    "ai.prompt.enhance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhance this image: increase apparent resolution, recover fine texture and type, reduce artifacts, and keep the original look. Do not change composition or add objects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强此图：提高清晰度与纹理、恢复文字细节、减少伪影，保持原有观感。不要改构图或添加物体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強此圖：提高清晰度與紋理、恢復文字細節、減少偽影，保持原有觀感。不要改構圖或添加物體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像感と質感を上げ、文字を回復し、アーティファクトを減らしてください。見た目の系統は変えず、構図や物体は追加しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선명도와 질감을 높이고 글자를 회복하며 아티팩트를 줄이세요. 원래 느낌을 유지하고 구도를 바꾸거나 물체를 추가하지 마세요."
          }
        }
      }
    },
    "ai.prompt.cleanup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean this image: remove dust, specks, compression blocks, and mild blur. Do not beautify faces, do not recompose, and keep authentic grain if present."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理此图：去掉灰尘、斑点、压缩块和轻微模糊。不要美化人脸，不要重构图，保留真实颗粒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理此圖：去掉灰塵、斑點、壓縮塊和輕微模糊。不要美化人臉，不要重構圖，保留真實顆粒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埃、斑点、圧縮ノイズ、軽いボケを除去してください。顔の美化や再構図はせず、本物の粒子は残してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼지, 반점, 압축 노이즈, 약한 흐림을 제거하세요. 얼굴을 보정하거나 재구성하지 말고 진짜 그레인은 남기세요."
          }
        }
      }
    },
    "ai.prompt.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this damaged photograph. Repair scratches, tears, stains, and fading. Preserve identity and period character. Do not modernize clothing or backgrounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复这张受损照片：处理划痕、撕裂、污渍和褪色。保留人物身份与年代气质，不要现代化服饰或背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修復這張受損照片：處理刮痕、撕裂、污漬和褪色。保留人物身份與年代氣質，不要現代化服飾或背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傷んだ写真を修復し、傷・破れ・汚れ・退色を直してください。人物と時代性は保ち、服装や背景を現代的にしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 사진을 복원해 긁힘, 찢어짐, 얼룩, 바램을 고치세요. 인물과 시대 분위기는 유지하고 옷이나 배경을 현대화하지 마세요."
          }
        }
      }
    },
    "ai.prompt.fill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the transparent / masked region so it matches the surrounding image. Keep lighting, perspective, texture, and style consistent. Do not change opaque areas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补全透明/蒙版区域，使其与周围图像一致。保持光线、透视、纹理和风格。不要改不透明区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "補全透明/遮罩區域，使其與周圍影像一致。保持光線、透視、紋理和風格。不要改不透明區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明/マスク領域を周囲と一致するように埋めてください。照明・遠近感・質感・スタイルを保ち、不透明部は変更しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명/마스크 영역을 주변과 맞게 채우세요. 조명, 원근, 질감, 스타일을 유지하고 불투명 영역은 바꾸지 마세요."
          }
        }
      }
    },
    "ai.prompt.removeObject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the object in the transparent / masked region and reconstruct a natural background that matches the surroundings. Leave no trace of the object or its shadow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉透明/蒙版区域中的物体，并重建匹配的自然背景。不要留下物体或其阴影的痕迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉透明/遮罩區域中的物體，並重建匹配的自然背景。不要留下物體或其陰影的痕跡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明/マスク領域の物体を除去し、周囲に合う自然な背景を再構築してください。物体や影の痕跡を残さないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명/마스크 영역의 물체를 제거하고 주변에 맞는 자연 배경을 재구성하세요. 물체나 그림자 흔적을 남기지 마세요."
          }
        }
      }
    },
    "ai.prompt.handwriting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove handwritten marks, signatures, ink strokes, doodles, and pen annotations. Preserve all printed text, typography, stamps, and printed graphics exactly. Keep paper texture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉手写笔迹、签名、墨迹和涂鸦。精确保留印刷文字、字体、印章和印刷图形。保留纸张纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉手寫筆跡、簽名、墨跡和塗鴉。精確保留印刷文字、字體、印章和印刷圖形。保留紙張紋理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書き、署名、インク、落書きを除去し、印刷文字・活字・印影・印刷グラフィックは正確に残してください。紙の質感も残してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손글씨, 서명, 잉크, 낙서를 제거하고 인쇄 문자, 활자, 도장, 인쇄 그래픽은 정확히 남기세요. 종이 질감도 유지하세요."
          }
        }
      }
    },
    "ai.prompt.removeText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove overlaid text, captions, watermarks made of type, and labels. Reconstruct the background. Preserve logos and graphics that are part of the original scene unless they are clearly added captions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉叠加的文字、标题、文字水印和标签，并重建背景。场景中原有的标志与图形予以保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉疊加的文字、標題、文字浮水印和標籤，並重建背景。場景中原有的標誌與圖形予以保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重ねられた文字、キャプション、文字ウォーターマーク、ラベルを除去して背景を再構築してください。元からあるロゴや図は残してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겹친 글자, 캡션, 문자 워터마크, 라벨을 제거하고 배경을 재구성하세요. 원래 장면의 로고와 그래픽은 남기세요."
          }
        }
      }
    },
    "ai.prompt.replaceBackground": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the background behind the main subject. Keep the subject, hair, and contact edges intact. Match lighting on the subject to the new environment. No extra people."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换主体背后的背景。保留主体、头发和接触边缘。让主体受光匹配新环境。不要增加人物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代主體背後的背景。保留主體、頭髮和接觸邊緣。讓主體受光匹配新環境。不要增加人物。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体の背後の背景だけを置き換え、髪と接地際は残してください。新しい環境の光に被写体を合わせ、人物は追加しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체 뒤 배경만 바꾸고 피사체, 머리카락, 접촉 가장자리는 유지하세요. 새 환경의 빛에 맞추고 사람을 추가하지 마세요."
          }
        }
      }
    },
    "ai.prompt.replaceSky": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the sky only. Keep the horizon, buildings, and foliage. Update the light on the land so it matches the new sky. Do not move the camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只替换天空。保留地平线、建筑和植被。让地面受光匹配新天空。不要移动机位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只取代天空。保留地平線、建築和植被。讓地面受光匹配新天空。不要移動機位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空だけを置き換え、地平線・建物・植生は残してください。地面の光を新しい空に合わせ、カメラ位置は動かさないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘만 바꾸고 수평선, 건물, 식생은 유지하세요. 땅의 빛을 새 하늘에 맞추고 카메라 위치는 옮기지 마세요."
          }
        }
      }
    },
    "ai.prompt.weather": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the weather and time of day as requested. Keep the scene layout. Update wetness, shadows, sky, and atmosphere consistently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求改变天气和时段。保持场景布局。湿润、阴影、天空和大气必须一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按要求改變天氣和時段。保持場景佈局。濕潤、陰影、天空和大氣必須一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定の天候と時間帯に変えてください。レイアウトは保ち、濡れ・影・空・大気を一貫させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 날씨와 시간대로 바꾸세요. 배치는 유지하고 젖음, 그림자, 하늘, 대기를 일관되게 하세요."
          }
        }
      }
    },
    "ai.prompt.recolor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolor the requested object or the masked region to the specified color. Keep material, logos, and shading. Do not recolor the whole frame unless asked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把指定物体或蒙版区域改成指定颜色。保留材质、标志和明暗。除非要求，不要给整幅改色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把指定物體或遮罩區域改成指定顏色。保留材質、標誌和明暗。除非要求，不要給整幅改色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定の物体またはマスク領域を指定色に再着色してください。材質・ロゴ・陰影は残し、求められない限り画面全体は再着色しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 물체 또는 마스크 영역을 지정 색으로 바꾸세요. 재질, 로고, 명암은 유지하고 요청이 없으면 화면 전체를 바꾸지 마세요."
          }
        }
      }
    },
    "ai.prompt.material": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the surface material of the object in the masked region or the main subject. Keep shape, branding, and lighting direction. The new material should catch light realistically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变蒙版区域或主体的表面材质。保持形状、品牌和光照方向。新材质必须真实受光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變遮罩區域或主體的表面材質。保持形狀、品牌和光照方向。新材質必須真實受光。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスク領域または被写体の材質を変え、形・ブランド・光の方向は保ってください。新しい材質は現実的に光を受けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크 영역 또는 피사체의 표면 재질을 바꾸세요. 형태, 브랜드, 빛 방향은 유지하고 새 재질은 현실적으로 빛을 받아야 합니다."
          }
        }
      }
    },
    "ai.prompt.harmonize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmonize this composite so every layer looks shot together. Match color temperature, contrast, grain, and light direction. Do not move subjects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一这张合成图，使各层看起来像同一次拍摄。匹配色温、对比、颗粒和光线方向。不要移动主体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統一這張合成圖，使各層看起來像同一次拍攝。匹配色溫、對比、顆粒和光線方向。不要移動主體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成を調和させ、同じ撮影に見えるように色温度・コントラスト・粒子・光の方向を合わせてください。被写体は動かさないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합성을 조화시켜 한 번에 찍은 것처럼 보이게 하세요. 색온도, 대비, 그레인, 빛 방향을 맞추고 피사체는 움직이지 마세요."
          }
        }
      }
    },
    "ai.prompt.shadow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a realistic contact shadow and gentle ambient occlusion under the main subject. Do not alter the subject. Keep the shadow consistent with existing light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为主体添加真实的接触阴影和轻微环境光遮蔽。不要改主体。阴影必须符合现有光线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為主體添加真實的接觸陰影和輕微環境光遮蔽。不要改主體。陰影必須符合現有光線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体の下に現実的な接地影と弱いAOを追加し、被写体自体は変えないでください。影は既存の光に合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체 아래에 실제 같은 접촉 그림자와 약한 앰비언트 오클루전을 추가하세요. 피사체는 바꾸지 말고 그림자는 기존 빛에 맞추세요."
          }
        }
      }
    },
    "ai.prompt.expand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend the image naturally beyond its original borders. Match perspective, lighting, texture, grain, and color. The join must be invisible. Do not alter the center photograph, and do not stroke the original rectangle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然延伸图像超出原边界。匹配透视、光线、纹理、颗粒和颜色。接缝必须看不见。不要改照片中心，也不要沿原图矩形描边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自然延伸影像超出原邊界。匹配透視、光線、紋理、顆粒和顏色。接縫必須看不見。不要改照片中心，也不要沿原圖矩形描邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の境界の外へ自然に伸ばしてください。遠近・照明・質感・粒子・色を合わせ、継ぎ目は見えないように。中央の写真は変えず、元の矩形をなぞらないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 경계를 넘어 자연스럽게 확장하세요. 원근, 조명, 질감, 입자, 색을 맞추고 이음매가 보이지 않아야 합니다. 중앙 사진은 바꾸지 말고 원래 사각형을 따라 그리지 마세요."
          }
        }
      }
    },
    "ai.prompt.fillFrame": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the entire frame. No black bars, white bars, letterboxing, padding, or any border. The subject must reach all four edges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺满整个画面。不要黑边、白边、letterbox、留白或任何外框。主体必须顶到四边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪滿整個畫面。不要黑邊、白邊、letterbox、留白或任何外框。主體必須頂到四邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体を埋めてください。黒帯・白帯・レターボックス・余白・枠は禁止。被写体は四辺まで達してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 전체를 채우세요. 검은 테두리, 흰 테두리, 레터박스, 여백, 액자는 안 됩니다. 피사체가 네 가장자리까지 닿아야 합니다."
          }
        }
      }
    },
    "ai.prompt.expandSeam": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The inner rectangle is the original photograph. Do not draw that border. Do not leave a color band or a hard cut. New pixels must match the original's white balance, contrast, and snow grain so the seam disappears."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内侧矩形是原图。不要画出这条边界，不要出现色差带或硬切。新像素必须在色温、对比和雪地颗粒上接住原图，让接缝消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內側矩形是原圖。不要畫出這條邊界，不要出現色差帶或硬切。新像素必須在色溫、對比和雪地顆粒上接住原圖，讓接縫消失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内側の矩形が元写真です。その境界を描かず、色帯や硬い切れ目を作らないでください。色温度・コントラスト・雪の粒子を元写真に合わせ、継ぎ目を消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안쪽 사각형이 원본입니다. 그 경계를 그리지 말고 색띠나 하드 컷이 없게 하세요. 색온도, 대비, 눈 입자를 원본에 맞춰 이음매를 없애세요."
          }
        }
      }
    },
    "ai.prompt.mask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following image is an edit mask. Transparent pixels are the region to change; opaque pixels must stay identical."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一张图是编辑蒙版。透明像素是需要改动的区域；不透明像素必须保持完全一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一張圖是編輯遮罩。透明像素是需要改動的區域；不透明像素必須保持完全一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の画像は編集マスクです。透明ピクセルが変更領域、不透明ピクセルは完全に同一のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 이미지는 편집 마스크입니다. 투명 픽셀이 변경 영역이고 불투명 픽셀은 완전히 동일해야 합니다."
          }
        }
      }
    },
    "ai.prompt.selectionContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pixels around the edit region are the real photograph — lighting, fur, grass, perspective, and color. Match that surrounding scene exactly. Do not invent a new backdrop, studio, or isolated cutout. Change only the masked / transparent pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区周围的像素是真实照片：光线、毛发、草地、透视和颜色。必须与周围场景完全衔接。不要发明新背景、棚拍或孤立剪贴画。只改蒙版/透明区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取範圍周圍的像素是真實照片：光線、毛髮、草地、透視和顏色。必須與周圍場景完全銜接。不要發明新背景、棚拍或孤立剪貼畫。只改遮罩/透明區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集領域の周囲は本物の写真です。照明・毛並み・芝生・遠近・色に合わせてください。新しい背景、スタジオ、切り抜きを作らないでください。マスク／透明部分だけを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 영역 주변은 실제 사진입니다. 조명, 털, 잔디, 원근, 색에 맞추세요. 새 배경, 스튜디오, 오려낸 조각은 만들지 마세요. 마스크/투명 픽셀만 바꾸세요."
          }
        }
      }
    },
    "ai.prompt.returnEditedPhoto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return the complete original photograph with only the masked region changed. Same framing and unmasked pixels. Do not return a cutout, sticker, or a new object on a blank or studio background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回完整原图，只改蒙版区域。构图和未蒙版像素必须相同。不要返回剪贴画、贴纸，或白底/棚拍上的新物体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回完整原圖，只改遮罩區域。構圖和未遮罩像素必須相同。不要返回剪貼畫、貼紙，或白底/棚拍上的新物體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスク領域だけを変えた元写真全体を返してください。構図と未マスク画素は同一のまま。切り抜き、ステッカー、白背景やスタジオ上の新しい物体は返さないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크 영역만 바꾼 원본 사진 전체를 반환하세요. 구도와 마스크 밖 픽셀은 같아야 합니다. 오려낸 조각, 스티커, 흰 배경/스튜디오 위 새 물체는 반환하지 마세요."
          }
        }
      }
    },
    "ai.prompt.noBorder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not stroke the selection or mask. Do not draw black lines, rectangles, or any frame around the edit. The edge must continue the surrounding fur and background with no seam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要沿选区或蒙版描边、画黑线、画矩形框或任何边框。边缘必须与周围毛发和背景无缝衔接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要沿選取範圍或遮罩描邊、畫黑線、畫矩形框或任何邊框。邊緣必須與周圍毛髮和背景無縫銜接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲やマスクに沿って輪郭線・黒線・矩形枠を描かないでください。端は周囲の毛並みと背景に自然につないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역이나 마스크를 따라 윤곽선, 검은 선, 사각 테두리를 그리지 마세요. 가장자리는 주변 털과 배경에 자연스럽게 이어져야 합니다."
          }
        }
      }
    },
    "ai.prompt.backgroundPhoto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the background photograph."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是背景原图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是背景原圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが背景の元写真です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 배경 원본 사진입니다."
          }
        }
      }
    },
    "ai.prompt.selectionMask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the selection mask. It has the exact same width and height as the photograph. White pixels are the selected region to edit; black pixels must stay identical."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是选区蒙版，宽高与原图完全相同。白色是要修改的选区，黑色必须保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是選取範圍遮罩，寬高與原圖完全相同。白色是要修改的選區，黑色必須保持原樣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが選択マスクです。幅と高さは元写真と同一です。白が編集する選択範囲、黒は元のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 선택 마스크입니다. 가로세로가 원본과 같습니다. 흰색은 수정할 선택 영역, 검은색은 그대로 두세요."
          }
        }
      }
    },
    "ai.prompt.editInstruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit instruction:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改说明："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改說明："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集指示："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 지시:"
          }
        }
      }
    },
    "ai.prompt.selectionBounds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected region in this image is x=%d y=%d width=%d height=%d, origin top-left. The photograph is %d × %d. Return the full image at that same size. Do not shift, scale, or crop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区在这张图中的位置是 x=%d y=%d，宽=%d 高=%d（左上角为原点）。照片为 %d × %d。请返回同样尺寸的完整照片，不要平移、缩放或裁切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取範圍在這張圖中的位置是 x=%d y=%d，寬=%d 高=%d（左上角為原點）。照片為 %d × %d。請返回同樣尺寸的完整照片，不要平移、縮放或裁切。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像内の選択範囲は x=%d y=%d、幅=%d 高さ=%d（原点は左上）です。写真は %d × %d です。同じサイズの写真全体を返し、平行移動・拡大縮小・切り抜きはしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지에서 선택 영역은 x=%d y=%d, 너비=%d 높이=%d(원점은 왼쪽 위)입니다. 사진은 %d × %d입니다. 같은 크기의 전체 사진을 반환하고 이동, 확대/축소, 자르기는 하지 마세요."
          }
        }
      }
    },
    "Merge Down": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下合并"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下合併"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のレイヤーと結合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 병합"
          }
        }
      }
    },
    "Merge Layers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并图层"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併圖層"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーを結合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 병합"
          }
        }
      }
    },
    "Merge Group": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併群組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを結合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 병합"
          }
        }
      }
    },
    "API key works.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーは有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 유효합니다."
          }
        }
      }
    },
    "API key works. %d models are visible on this account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥可用。此账号可见 %d 个模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰可用。此帳號可見 %d 個模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーは有効です。このアカウントでは%d個のモデルが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 유효합니다. 이 계정에서 모델 %d개가 보입니다."
          }
        }
      }
    },
    "The API key could not be locked to this Mac (Keychain status %d).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把 API 密钥锁定到这台 Mac（钥匙串状态 %d）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把 API 金鑰鎖定到這台 Mac（鑰匙圈狀態 %d）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーをこのMacにロックできませんでした（キーチェーン状態 %d）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 이 Mac에 잠글 수 없습니다(키체인 상태 %d)."
          }
        }
      }
    },
    "The saved API credentials file is damaged and cannot be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 API 凭据文件已损坏，无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的 API 憑證檔案已損壞，無法讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのAPI認証ファイルが破損していて読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 API 자격 증명 파일이 손상되어 읽을 수 없습니다."
          }
        }
      }
    },
    "Enter a valid Base URL, such as https://zenmux.ai/api/v1.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 Base URL，例如 https://zenmux.ai/api/v1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的 Base URL，例如 https://zenmux.ai/api/v1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "https://zenmux.ai/api/v1 のような有効なベースURLを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https://zenmux.ai/api/v1 같은 유효한 Base URL을 입력하세요."
          }
        }
      }
    },
    "Creates a new layer from a text prompt. With no canvas open, the image becomes the document.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据文字提示创建新图层。若未打开画布，生成的图像会成为文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據文字提示建立新圖層。若未開啟畫布，產生的影像會成為文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストから新規レイヤーを作ります。キャンバスが無い場合、画像がドキュメントになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 프롬프트로 새 레이어를 만듭니다. 캔버스가 없으면 이미지가 문서가 됩니다."
          }
        }
      }
    },
    "Paints a new interpretation of the current canvas onto a new layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把当前画布的新诠释画到一个新图层上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把目前畫布的新詮釋畫到一個新圖層上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のキャンバスの新しい解釈を新規レイヤーに描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 캔버스의 새로운 해석을 새 레이어에 그립니다."
          }
        }
      }
    },
    "Generates a tile-friendly texture or pattern as a new layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成适合平铺的纹理或图案，作为新图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生適合平鋪的紋理或圖案，作為新圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル向きのテクスチャやパターンを新規レイヤーとして生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링에 적합한 텍스처나 패턴을 새 레이어로 생성합니다."
          }
        }
      }
    },
    "Builds a layout-heavy graphic with readable type, good for Qwen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成版式感强、文字可读的图形，适合 Qwen。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生版式感強、文字可讀的圖形，適合 Qwen。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすい文字のレイアウト重視グラフィックを作ります。Qwen向きです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 쉬운 글자가 있는 레이아웃 그래픽을 만듭니다. Qwen에 적합합니다."
          }
        }
      }
    },
    "Keeps the composition and redraws it in another medium or look.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持构图，用另一种媒介或风格重绘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持構圖，用另一種媒介或風格重繪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構図を保ったまま別の画材や見た目で描き直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구도를 유지한 채 다른 매체나 분위기로 다시 그립니다."
          }
        }
      }
    },
    "Turns line work or a rough block-in into a finished picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把线稿或粗略铺色变成完成图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把線稿或粗略鋪色變成完成圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線画やラフを完成した絵にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선화나 러프를 완성된 그림으로 바꿉니다."
          }
        }
      }
    },
    "Adds plausible color to a black-and-white or faded image.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为黑白或褪色图像补上合理颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為黑白或褪色影像補上合理顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白黒や色褪せた画像に妥当な色を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흑백이거나 바랜 이미지에 자연스러운 색을 입힙니다."
          }
        }
      }
    },
    "Changes the lighting direction and quality without rebuilding the scene.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不重建场景，只改变光线方向与质感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不重建場景，只改變光線方向與質感。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーンを作り直さず、光の方向と質だけを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면을 다시 만들지 않고 빛의 방향과 질만 바꿉니다."
          }
        }
      }
    },
    "Returns a sharper, higher-resolution layer displayed at the original size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回更清晰、更高分辨率的图层，仍按原尺寸显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回更清晰、更高解析度的圖層，仍按原尺寸顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりシャープで高解像度のレイヤーを元の表示サイズで返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 선명하고 고해상도인 레이어를 원래 표시 크기로 반환합니다."
          }
        }
      }
    },
    "Removes dust, compression, and mild blur while keeping the photo honest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉灰尘、压缩痕迹和轻微模糊，同时保持照片真实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉灰塵、壓縮痕跡和輕微模糊，同時保持照片真實。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホコリ・圧縮・軽いボケを取り除き、写真の正直さは保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼지, 압축 노이즈, 약한 흐림을 제거하되 사진의 진솔함은 유지합니다."
          }
        }
      }
    },
    "Repairs scratches, stains, and fading on archival photographs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复档案照片上的划痕、污渍和褪色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修復檔案照片上的刮痕、污漬和褪色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存写真の傷、シミ、色褪せを修復します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 사진의 긁힘, 얼룩, 바램을 복원합니다."
          }
        }
      }
    },
    "Edits the current layer in place. Only the selected pixels change; nothing new is added to the Layers list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前图层上就地修改。只改选区内的像素，不会新增图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在目前圖層上就地修改。只改選取範圍內的像素，不會新增圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のレイヤーを直接編集します。選択内のピクセルだけが変わり、新しいレイヤーは追加しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 레이어를 제자리에서 수정합니다. 선택 영역 픽셀만 바뀌고 새 레이어는 생기지 않습니다."
          }
        }
      }
    },
    "Erases whatever is inside the selection and rebuilds a matching background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除选区内的内容并重建匹配的背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除選取範圍內的內容並重建匹配的背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内のものを消し、周囲に合う背景を再構築します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 안을 지우고 어울리는 배경을 다시 만듭니다."
          }
        }
      }
    },
    "Clears pen marks and signatures. Printed type and graphics are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除笔迹和签名，保留印刷文字与图形。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除筆跡和簽名，保留印刷文字與圖形。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書きと署名を消し、印刷文字と図は残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필기와 서명을 지우고 인쇄 글자와 그래픽은 남깁니다."
          }
        }
      }
    },
    "Removes captions, labels, and overlaid type. A selection limits the pass.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去除标题、标签和叠加文字。选区可限制范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去除標題、標籤和疊加文字。選取範圍可限制範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプション、ラベル、重ね文字を除去します。選択で範囲を限定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡션, 라벨, 겹친 글자를 제거합니다. 선택 영역으로 범위를 제한할 수 있습니다."
          }
        }
      }
    },
    "Keeps the subject and builds a new environment behind it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留主体，在其背后生成新环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留主體，在其背後產生新環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体を残し、背後に新しい環境を作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체는 유지하고 뒤에 새 환경을 만듭니다."
          }
        }
      }
    },
    "Replaces only the sky and the light it throws on the scene.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只替换天空及其投射到场景上的光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只替換天空及其投射到場景上的光。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空と、それがシーンに落とす光だけを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘과 그것이 장면에 던지는 빛만 바꿉니다."
          }
        }
      }
    },
    "Changes weather and time of day across the frame or the selection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变整幅或选区内的天气与时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變整幅或選取範圍內的天氣與時段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体または選択範囲の天候と時刻を変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 또는 선택 영역의 날씨와 시간을 바꿉니다."
          }
        }
      }
    },
    "Shifts the color of the selected object while keeping material and shading.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变所选物体的颜色，保留材质与明暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變所選物體的顏色，保留材質與明暗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した物体の色だけを変え、材質と陰影は保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 물체의 색만 바꾸고 재질과 음영은 유지합니다."
          }
        }
      }
    },
    "Keeps the object's shape and assigns a new surface.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持物体形状，赋予新表面材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持物體形狀，賦予新表面材質。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形は保ったまま新しい表面を与えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물체 형태는 유지하고 새 표면을 입힙니다."
          }
        }
      }
    },
    "Matches lighting and color so a composite looks like one photograph.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一光色，让合成看起来像一张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統一光色，讓合成看起來像一張照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照明と色を合わせて、合成を一枚の写真に見せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명과 색을 맞춰 합성이 한 장의 사진처럼 보이게 합니다."
          }
        }
      }
    },
    "Adds a grounded contact shadow under the subject.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主体下方添加贴地接触阴影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主體下方新增貼地接觸陰影。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体の下に接地したコンタクトシャドウを加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체 아래에 땅에 붙는 접촉 그림자를 넣습니다."
          }
        }
      }
    },
    "Grows the canvas and paints the new borders so they continue the picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩大画布并绘制新边，使画面自然延续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擴大畫布並繪製新邊，使畫面自然延續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスを広げ、新しい余白を絵の続きとして描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 키우고 새 가장자리를 그림의 연장으로 그립니다."
          }
        }
      }
    },
    "A sunlit studio still life of citrus on linen, soft shadows, 50mm photograph": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阳光工作室里亚麻布上的柑橘静物，柔和阴影，50mm 照片"
