    "Shift-U switches between Rectangle and Ellipse": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-U 在矩形和椭圆之间切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
