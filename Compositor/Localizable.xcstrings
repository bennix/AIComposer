    },
    "These layers supply live masks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些图层提供实时蒙版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
