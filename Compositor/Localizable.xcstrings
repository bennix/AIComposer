    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后源点随笔刷移动；关闭则每笔都从源点开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後來源隨筆刷移動；關閉則每筆都從來源開始"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンでソースがブラシと一緒に移動。オフは各ストロークをソース位置から開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 소스가 브러시와 함께 움직이고, 끄면 매 획이 소스에서 시작됩니다"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此点。图像不缩放；裁掉的内容仍在画布外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此點。影像不縮放；裁掉的內容仍在畫布外。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この点を固定します。拡大縮小せず、はみ出した内容はキャンバス外に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 점을 고정합니다. 크기는 바꾸지 않으며 잘린 내용은 캔버스 밖에 남습니다."
          }
        }
      }
    },
